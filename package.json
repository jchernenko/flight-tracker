{
  "name": "flight-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @flight/api & npm run dev --workspace @flight/web",
    "build": "npm run build --workspace @flight/web",
    "start": "npm run start --workspace @flight/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "5.9.3"
  }
}
