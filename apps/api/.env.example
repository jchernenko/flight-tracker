# Home position the scope is centered on. Use your own location; don't commit it.
HOME_LAT=49.2
HOME_LON=-122.6
# Place name shown in the display's header.
HOME_NAME=Home

# How far out to fetch aircraft (nm). The app's largest range is 60.
FETCH_RADIUS_NM=60

# adsblol | airplaneslive | readsb | demo
#   readsb: your own receiver; set FEED_URL to its aircraft.json
#   demo:   fake traffic, no network needed
FEED_PROVIDER=adsblol
# FEED_URL=http://raspberrypi.local:8080/data/aircraft.json

# Upstream is called at most once per window, however many screens are open.
CACHE_TTL_MS=5000

# Look up origin/destination for airline flights (adsbdb.com callsign API).
ROUTES_ENABLED=true

# Optional FlightAware AeroAPI key (Personal tier) for routes adsbdb misses.
# Only aircraft within AEROAPI_RADIUS_NM of home are looked up, nearest first,
# at most AEROAPI_DAILY_LIMIT a day (30 x ~$0.005 stays inside the free $5/month).
# AEROAPI_KEY=
# AEROAPI_DAILY_LIMIT=30
# AEROAPI_RADIUS_NM=30

# Built web app the API serves in production (relative to apps/api).
# WEB_DIST_DIR=../web/dist

# PORT is set by Railway; defaults to 3000 locally.
# PORT=3000
